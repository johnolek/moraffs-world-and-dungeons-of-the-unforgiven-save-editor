{
  "name": "moraff-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify-run": "vite build --config vite.verify.config.ts --logLevel warn && node dist-cli/verify-run.mjs",
    "build:server": "vite build --config vite.server.config.ts --logLevel warn",
    "build:engine": "vite build --config vite.engine.config.ts --logLevel warn",
    "build:ported": "node scripts/build-ported-from.mts",
    "publish:engine": "vite build --config vite.publish-engine.config.ts --logLevel warn && node dist-server/publish-engine.mjs",
    "start:server": "node dist-server/main.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "pg": "^8.23.0"
  }
}
